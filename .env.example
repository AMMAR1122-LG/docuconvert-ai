# Copy this file to .env and fill in real values before running
# docker compose up. Nothing here is a real secret.

# --- General ---
ENV=development

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Database (docker-compose overrides this to point at the postgres
# service; only needed here for running the backend outside Docker) ---
DATABASE_URL=sqlite:///./docuconvert.db

# --- File storage ---
# local | s3  (s3 also covers Cloudflare R2 — just point S3_ENDPOINT at it)
STORAGE_BACKEND=local
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=auto

# --- AI providers (only the one matching AI_PROVIDER needs a key) ---
AI_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Payments ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Frontend ---
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
